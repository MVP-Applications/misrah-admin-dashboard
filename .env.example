# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Base URL of the Misrah backend API.
# Currently only the test environment is available.
# TODO: add VITE_API_BASE_URL_PROD (and a VITE_APP_ENV switch in src/config/env.ts)
# once a staging/production URL exists.
VITE_API_BASE_URL="https://misra-test.mvp-apps.ae"

# VITE_API_KEY: Platform-validation key required by the backend on every request
# (header: x-api-key). Per the API docs this identifies the calling platform
# (Web/Android/iOS) rather than authenticating a user, so it is NOT treated as a
# secret here — it is bundled into the client build like any other public config.
# Get the real value from the backend team.
VITE_API_KEY="MY_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps browser key for the property location map
# (Add Listing → "Where is it located?"). Enable "Maps JavaScript API" and
# "Geocoding API" on the key, and restrict it by HTTP referrer to the dashboard's
# domains. Without it the map shows a setup message instead.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# VITE_SEND_DEVICE_HEADERS: "true" sends x-device-id / x-device-name /
# x-client-location on auth requests (Authenticated Sessions list). Only enable
# once the backend's CORS Access-Control-Allow-Headers includes all three —
# otherwise the browser blocks login.
VITE_SEND_DEVICE_HEADERS="false"
